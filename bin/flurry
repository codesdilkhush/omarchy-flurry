#!/bin/bash
# flurry: drive the Flurry plugin from a terminal or a Hyprland bind.
#   flurry [toggle|on|off|next|effect <name>|intensity <0.25-2>|decorate|santa|yeti|plow|lights|snowballs|
#           shake|fireworks [seconds]|season <auto|winter|spring>|surprise [bird|cat|golden]|
#           weather [on|off|now|status]|city <name>|location <lat> <lon>|calm <off|on|work>|
#           ornaments [style|next]|throwto <friend>|
#           gusts|writing|daycycle|seasons|newyear|surprises|theme|throwing|
#           code|name <name>|add <friend-code>|note <friend> <text>|status|clear]
set -euo pipefail
call() { omarchy-shell flurry "$@"; }
cmd=${1:-toggle}; shift || true
case $cmd in
  toggle|on|off|next|decorate|santa|yeti|plow|lights|snowballs|status|clear|shake) call "$cmd" ;;
  effect) call effect "${1:?snow|leaves|starfall|rain|sakura|fireflies}" ;;
  intensity) call intensity "${1:?0.25 to 2}" ;;
  fireworks) call fireworks "${1:-60}" ;;
  season) call season "${1:?auto|winter|spring}" ;;
  surprise) call surprise "${1:-}" ;;
  weather) call weather "${1:-status}" ;;
  city) call city "${*:?city name}" ;;
  location) call location "${1:?latitude}" "${2:?longitude}" ;;
  calm) call calm "${1:?off|on|work}" ;;
  ornaments) call ornaments "${1:-next}" ;;
  throwto) call throwTo "${1:?friend}" ;;
  gusts) call toggleFlag windGusts ;;
  writing) call toggleFlag writing ;;
  daycycle) call toggleFlag dayCycle ;;
  seasons) call toggleFlag seasons ;;
  newyear) call toggleFlag newYear ;;
  surprises) call toggleFlag surprises ;;
  theme) call toggleFlag themeSync ;;
  throwing) call toggleFlag throwToFriends ;;
  code) call friendCode ;;
  name) call setName "${1:?name}" ;;
  add) call addFriend "${1:-$(wl-paste --no-newline)}" ;;
  note) call note "${1:?friend}" "${2:?text}" ;;
  -h|--help|help) sed -n 2,8p "$0" ;;
  *) echo "flurry: unknown command '$cmd'" >&2; exit 1 ;;
esac
